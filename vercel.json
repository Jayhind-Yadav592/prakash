{
  "version": 2,
  "builds": [
    {
      "src": "medicarehub/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": [
          "media/**",
          "static/**",
          "staticfiles/**",
          "templates/**",
          "catalogue/**",
          "db.sqlite3"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "medicarehub/wsgi.py"
    }
  ]
}
